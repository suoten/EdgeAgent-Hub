# EdgeAgent Hub AI Sidecar Dockerfile (Python)
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY ai_sidecar/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 复制 sidecar 代码
COPY ai_sidecar/ /app/

ENV TZ=Asia/Shanghai
ENV PYTHONUNBUFFERED=1

CMD ["python", "/app/inference_onnx.py", "--nats-url", "nats://nats:4222", "--model-dir", "/models/onnx"]
